rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar: verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Regra para a coleção users
    // Apenas o próprio usuário pode ler/escrever seu documento
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Regra para a coleção keys
    // Qualquer usuário autenticado pode ler e escrever
    match /keys/{keyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Regra para a coleção people
    // Qualquer usuário autenticado pode ler e escrever
    match /people/{personId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Regra para a coleção movements
    // Qualquer usuário autenticado pode ler e escrever
    match /movements/{movementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
